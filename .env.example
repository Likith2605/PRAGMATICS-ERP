SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
PORT=3001
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/newDB
ERP_ADMIN_EMAIL=admin@example.com
ERP_ADMIN_PASSWORD=replace-with-a-unique-long-password
ERP_ADMIN_NAME=Administrator
ERP_SESSION_TTL_HOURS=12
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
FILE_STORAGE_DIR=./storage
MAX_DRAWING_BYTES=52428800
# Set to true only when your hosted PostgreSQL provider requires TLS.
DATABASE_SSL=false
# Vite uses this URL for the browser-to-API connection.
VITE_API_URL=http://localhost:3001/api/ballooning
VITE_API_BASE_URL=http://localhost:3001/api

# QualityApp sync server (backend the mobile QC app syncs with).
# 'Send to Quality Module' mirrors drawings + dimensions there so the
# mobile app receives them live via socket.io and periodic sync pulls.
QC_SERVER_URL=http://localhost:4000
QC_SYNC_EMPLOYEE_ID=ADMIN
QC_SYNC_PASSWORD=admin123

# Reverse sync: pull inspection results (checks/measurements/dispatches) from# the mobile QC server into the ERP Quality Module. QC_PULL_ENABLED=0 disables.
QC_PULL_ENABLED=1
QC_PULL_INTERVAL_MS=30000
