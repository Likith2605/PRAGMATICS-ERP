{
    "name": "quotation-management-erp",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.js",
        "dev:frontend": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "server": "node server.js",
        "db:migrate": "node server/migrate.js",
        "db:check": "node -e \"import('./server/database.js').then(async ({checkDatabase, closeDatabase}) => { console.log((await checkDatabase()) ? 'PostgreSQL connected' : 'PostgreSQL unavailable'); await closeDatabase(); }).catch(error => { console.error(error.message); process.exit(1); })\"",
        "test:ballooning": "node tests/ballooning.test.mjs",
        "test:auth": "node tests/auth-login.test.mjs",
        "test:employee-assignment-delete": "node tests/employee-assignment-delete.test.mjs",
        "test:role-permissions": "node tests/role-permission-sync.test.mjs",
        "test:role-permission-integration": "node tests/role-permission-integration.test.mjs",
        "test:ballooning-dimensions": "node tests/ballooning-dimension-detection.test.mjs",
        "test:postgres": "node tests/postgresql.test.mjs",
        "test:qc-pdf-upload": "node tests/qc-pdf-upload.test.mjs",
        "test:quality-report": "node tests/quality-report.test.mjs",
        "test:db-crud": "node tests/db-crud.test.mjs",
        "test:workflow": "node tests/workflow.test.mjs",
        "test:workflow-dashboard": "node tests/workflow-dashboard-render.test.mjs",
        "test:workflow-navigator-jobcard": "node tests/workflow-navigator-jobcard.test.mjs",
        "test:po-fulfillment-pdf": "node tests/po-fulfillment-pdf.test.mjs",
        "test:production-dispatch": "node tests/production-dispatch.test.mjs",
        "test:currency": "node tests/currency.test.mjs",
        "test:contact-validation": "node tests/contact-field-validation.test.mjs",
        "test:audit": "node tests/erp-full-audit.test.mjs",
        "test:files": "node tests/file-api.test.mjs",
        "test:records": "node tests/records-api.test.mjs",
        "test:all": "node tests/ballooning.test.mjs && node tests/currency.test.mjs && node tests/workflow.test.mjs && node tests/db-crud.test.mjs && node tests/erp-full-audit.test.mjs && node tests/file-api.test.mjs && node tests/records-api.test.mjs && node tests/reports-and-lot.test.mjs && node tests/report-filters.test.mjs && node tests/track-a-reports.test.mjs",
        "start": "node server.js & vite",
        "test:reports": "node tests/reports-and-lot.test.mjs",
        "test:report-filters": "node tests/report-filters.test.mjs",
        "test:material-ack": "node tests/material-ack.test.mjs",
        "test:material-ack-ui": "node tests/material-ack-ui.mjs",
        "test:material-ack-all": "node tests/material-ack.test.mjs && node tests/material-ack-ui.mjs",
        "test:store-issue-refs": "node tests/store-issue-refs.test.mjs",
        "test:store-pending-ui": "node tests/store-pending-requests-ui.mjs",
        "test:store-issue-entry-all": "node tests/store-issue-refs.test.mjs && node tests/store-pending-requests-ui.mjs",
        "test:inventory-store-sections": "node tests/inventory-store-sections.test.mjs"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "dotenv": "^16.4.7",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "html2canvas": "^1.4.1",
        "jspdf": "^2.5.1",
        "jspdf-autotable": "^3.5.28",
        "lucide-react": "^0.468.0",
        "multer": "^2.5.0",
        "nodemailer": "^10.0.10",
        "pdfjs-dist": "^6.2.108",
        "pg": "^8.13.1",
        "qrcode": "^1.5.4",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.16.0",
        "tesseract.js": "^7.0.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.5.0",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.15",
        "vite": "^5.4.0"
    }
}
